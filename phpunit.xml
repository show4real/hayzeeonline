<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
          These two are not optional. Most Feature tests use RefreshDatabase,
          which migrates:fresh the configured connection — and with no override
          here that connection is the one in .env, so running the suite would
          drop every table in the real hayzee_pos database. An in-memory SQLite
          database is created and discarded per test instead.
        -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="SCOUT_DRIVER" value="null"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Paystack and Stripe must never be reached from a test. -->
        <env name="PAYSTACK_SECRET_KEY" value="sk_test_phpunit"/>
        <env name="STRIPE_SECRET_KEY" value="sk_test_phpunit"/>
    </php>
</phpunit>
