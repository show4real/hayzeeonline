APP_NAME="Hayzee Online"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# Must match the domain the API is actually served on. productTrait stores
# absolute image URLs built from it, so a wrong value is written into the
# database and handed to every client.
APP_URL=http://localhost:8086

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Host/port as seen FROM THE HOST, so the IDE and a host-side `php artisan`
# work. The containers override these with the service names (see
# docker-compose.local.yml), which is why both can be right at once.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3312
DB_DATABASE=hayzee_pos
DB_USERNAME=hayzee
DB_PASSWORD=secret
# Used only by the local MySQL container's healthcheck and root login.
DB_ROOT_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# `database`, not `sync`: mail is dispatched as a job, and the local stack runs
# a queue worker for exactly that reason.
QUEUE_CONNECTION=database
CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6381

# Mailpit, from the local stack. UI at http://localhost:8027
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@hayzeeonline.com"
MAIL_FROM_NAME="${APP_NAME}"

# tymon/jwt-auth. Generate with: php artisan jwt:secret
# Without it every login fails at runtime rather than at boot, because the
# containers run config:cache and env() is never consulted again.
JWT_SECRET=
JWT_TTL=60

# Product search. `database` falls back to SQL LIKE queries and needs no
# external service, which is the easiest way to work offline.
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=false
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# Payments. Both are read through config/services.php, never env() directly.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co
MERCHANT_EMAIL=

STRIPE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Storefront AI assistant (App\Services\ChatAgent).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Local Docker stack — published host ports.
# ---------------------------------------------------------------------------
# Defaults chosen not to clash with the other projects on this machine.
# Change any of these if something else already holds the port.
NGINX_PORT=8086
DB_PORT_HOST=3312
REDIS_PORT_HOST=6381
MAILPIT_UI_PORT=8027
PMA_PORT=3703

# ---------------------------------------------------------------------------
# Production only (set in the ENV_PRODUCTION GitHub secret, not here).
# ---------------------------------------------------------------------------
# APP_PORT is the port the container publishes on loopback for Apache to
# proxy to. The deploy workflow passes it in and overrides whatever the
# secret says, so the vhost and the container can never disagree.
# APP_PORT=8096
